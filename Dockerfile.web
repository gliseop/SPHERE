FROM node:24-bookworm-slim AS frontend-builder

WORKDIR /app/web/frontend

COPY web/frontend/package.json web/frontend/package-lock.json ./
RUN npm ci

COPY web/frontend/ ./
RUN npm run build


FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY web/__init__.py ./web/__init__.py
COPY web/backend ./web/backend
COPY data ./data
COPY scenarios ./scenarios
COPY .env.example ./

RUN pip install --upgrade pip \
    && pip install -e ".[lc,dev]" \
    && pip install -r web/backend/requirements.txt

COPY --from=frontend-builder /app/web/frontend/dist ./web/frontend/dist
COPY docker/web-entrypoint.sh /usr/local/bin/sphere-web-entrypoint

RUN chmod +x /usr/local/bin/sphere-web-entrypoint \
    && mkdir -p /app/results /app/data /app/scenarios /data

EXPOSE 8765

ENTRYPOINT ["sphere-web-entrypoint"]
