# Скопировать в .env и заполнить перед деплоем.
# Сгенерировать JWT_SECRET: python -c "import secrets; print(secrets.token_hex(32))"

# LLM / embeddings
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
OPENAI_API_KEY=
# Для OpenRouter укажите https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# Опциональный routing order для OpenRouter, например: Groq,OpenAI
OPENROUTER_PROVIDER_ORDER=
# Жёсткий timeout одной попытки LLM-вызова (секунды)
SPHERE_LLM_REQUEST_TIMEOUT_S=30
# Общий deadline одного модельного ответа с учётом retries (секунды)
SPHERE_LLM_CALL_DEADLINE_S=30

JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRE_HOURS=24
ALLOWED_ORIGIN=https://your-domain.com

# Dev-mode switch (allows JWT_SECRET fallback). Never enable in production.
SPHERE_DEV=0

# Safety limits
SPHERE_MAX_RUNNING=5
SPHERE_MAX_BODY_BYTES=2097152
